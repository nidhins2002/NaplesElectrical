# ─── ADMIN PORTAL & GITHUB DIRECT COMMIT (Option 2) ───────────────────────────
# Master password for logging into /admin
ADMIN_PASSWORD=NaplesAdmin2026!

# GitHub Personal Access Token (PAT) with 'repo' or 'contents: write' scope.
# When provided on Vercel, edits made in /admin will automatically commit directly
# to GitHub and trigger instant Vercel redeployment without any database!
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO=nidhins2002/NaplesElectrical
GITHUB_BRANCH=main

# ─── GOOGLE PLACES API (Optional - for live Google reviews) ───────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
